rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    /**
     * 🛡️ FUNCIÓN DE VALIDACIÓN MULTITENANT
     * Compara el tenant_id inyectado en el JWT (Custom Claims)
     * con el rastro de tenencia del recurso en Firestore.
     */
    function belongsToTenant() {
      return request.auth != null && 
             request.auth.token.tenant_id == resource.data.tenant_id;
    }

    /**
     * 🛡️ FUNCIÓN PARA CREACIÓN PROTEGIDA
     * Obliga a que cada nuevo documento herede el tenant_id
     * del token de identidad del usuario. Previniendo inyección cruzada.
     */
    function isCreateValid() {
      return request.auth != null && 
             request.resource.data.tenant_id == request.auth.token.tenant_id;
    }

    // --- REGLAS DE LA CONSTITUCIÓN FIDUCIARIA ---

    // Colección Staff: Perfiles operativos
    match /staff/{uid} {
      // Un operario solo puede leer/editar su propio perfil y debe ser de su tenant
      allow read, update: if request.auth != null && 
                           request.auth.uid == uid && 
                           belongsToTenant();
      
      // La creación se permite si el tenant_id coincide (manejado por Cloud Functions)
      allow create: if isCreateValid();
    }

    // Colección Leads: Gestión comercial
    match /leads/{leadId} {
      allow read, update, delete: if belongsToTenant();
      allow create: if isCreateValid();
    }

    // Fallback: Default-Deny (Cierre total por defecto)
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
